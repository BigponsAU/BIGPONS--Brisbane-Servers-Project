---
type Variant = 'banner';

interface Props {
  /** Native HTML wordmark lockup for inquiry panels. */
  variant?: Variant;
  caption?: string;
  class?: string;
  alt?: string;
}

const {
  variant = 'banner',
  caption,
  class: className = '',
  alt,
} = Astro.props;

const bannerLabel =
  alt ??
  "BIGPONS — Brisbane Servers. Access to truth in technology. Local data pipeline solutions and Brisbane's sovereign edge infrastructure.";
const gradientId = `brand-lockup-gradient-${Math.random().toString(36).slice(2, 11)}`;
---

{
  variant === 'banner' && (
    <figure
      class:list={['brand-visual', 'brand-visual--banner', className]}
      aria-label={bannerLabel}
    >
      <div class="brand-lockup">
        <svg
          class="brand-lockup__mark"
          viewBox="0 0 64 64"
          role="img"
          aria-hidden="true"
          focusable="false"
        >
          <defs>
            <linearGradient id={gradientId} x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#0A74DA" />
              <stop offset="100%" stop-color="#1e3a5f" />
            </linearGradient>
          </defs>
          <circle cx="32" cy="28" r="3" fill={`url(#${gradientId})`} />
          <circle cx="22" cy="22" r="2.5" fill={`url(#${gradientId})`} />
          <circle cx="42" cy="22" r="2.5" fill={`url(#${gradientId})`} />
          <circle cx="18" cy="32" r="2" fill={`url(#${gradientId})`} />
          <circle cx="46" cy="32" r="2" fill={`url(#${gradientId})`} />
          <circle cx="26" cy="38" r="2" fill={`url(#${gradientId})`} />
          <circle cx="38" cy="38" r="2" fill={`url(#${gradientId})`} />
          <circle cx="32" cy="44" r="2.5" fill={`url(#${gradientId})`} />
          <circle cx="48" cy="42" r="1.8" fill={`url(#${gradientId})`} />
          <line x1="32" y1="28" x2="22" y2="22" stroke={`url(#${gradientId})`} stroke-width="1.2" opacity="0.7" />
          <line x1="32" y1="28" x2="42" y2="22" stroke={`url(#${gradientId})`} stroke-width="1.2" opacity="0.7" />
          <line x1="32" y1="28" x2="18" y2="32" stroke={`url(#${gradientId})`} stroke-width="1.2" opacity="0.7" />
          <line x1="32" y1="28" x2="46" y2="32" stroke={`url(#${gradientId})`} stroke-width="1.2" opacity="0.7" />
          <line x1="32" y1="28" x2="26" y2="38" stroke={`url(#${gradientId})`} stroke-width="1.2" opacity="0.7" />
          <line x1="32" y1="28" x2="38" y2="38" stroke={`url(#${gradientId})`} stroke-width="1.2" opacity="0.7" />
          <line x1="26" y1="38" x2="32" y2="44" stroke={`url(#${gradientId})`} stroke-width="1.2" opacity="0.7" />
          <line x1="38" y1="38" x2="32" y2="44" stroke={`url(#${gradientId})`} stroke-width="1.2" opacity="0.7" />
          <line x1="46" y1="32" x2="48" y2="42" stroke={`url(#${gradientId})`} stroke-width="1.2" opacity="0.7" />
          <line x1="22" y1="22" x2="18" y2="32" stroke={`url(#${gradientId})`} stroke-width="1" opacity="0.5" />
          <line x1="42" y1="22" x2="46" y2="32" stroke={`url(#${gradientId})`} stroke-width="1" opacity="0.5" />
        </svg>
        <div class="brand-lockup__copy">
          <p class="brand-lockup__name">BIGPONS</p>
          <p class="brand-lockup__product">Brisbane Servers</p>
          <p class="brand-lockup__tagline">Access to truth in technology</p>
        </div>
      </div>
      <hr class="brand-lockup__rule" aria-hidden="true" />
      <p class="brand-lockup__footer">
        Local Data Pipeline Solutions | Brisbane's Sovereign Edge Infrastructure
      </p>
      {caption && <figcaption class="brand-visual__caption">{caption}</figcaption>}
    </figure>
  )
}
