---
import AccountWorkspacePanelBand from './AccountWorkspacePanelBand.astro';
---

<div id="admin-users-panel" class="portal-panel panel-shell" data-min-role="admin" role="main" aria-label="Registered users" style="display: none;">
  <div class="admin-content admin-users-panel-shell">
    <AccountWorkspacePanelBand
      semanticKey="account-admin-users"
      eyebrow="Platform"
      title="Users &amp; sign-in audit"
      byline="Registered accounts from Neon auth. Verification emails send from support@brisbaneservers.com (Resend root domain)."
      titleId="admin-users-heading"
      variant="primary-light"
    >
      <div slot="actions" class="section-actions admin-panel-quick-links admin-users-toolbar">
        <button type="button" class="btn btn-secondary btn-sm" onclick="navigateToPanel('admin-ops')">Ops</button>
        <button type="button" class="btn btn-secondary btn-sm" onclick="navigateToPanel('admin-billing')">Billing</button>
        <label class="sr-only" for="admin-users-search">Filter users</label>
        <input
          id="admin-users-search"
          type="search"
          class="form-input admin-users-search"
          placeholder="Filter by email or role…"
          autocomplete="off"
        />
        <button id="admin-users-export-btn" type="button" class="btn btn-secondary btn-sm">Export CSV</button>
        <button id="admin-users-refresh-btn" type="button" class="btn btn-secondary btn-sm">Refresh</button>
      </div>

    <section class="admin-section admin-section--in-band" aria-labelledby="admin-users-heading">

      <details class="panel-guidance-details">
        <summary>Roles &amp; workspace access</summary>
        <div class="panel-guidance-details__body">
          <p><strong>Client / viewer:</strong> Account home by default. Tick Workspace to grant the full creator dashboard.</p>
          <p><strong>Editor / admin:</strong> Workspace is always on via role (checkbox stays ticked and locked).</p>
          <p><strong>Remove:</strong> Soft-removes the account with a backup snapshot so it can be restored. Sign-in is blocked until restore.</p>
          <p><strong>Auth audit</strong> below lists recent sign-ins, registrations, and OAuth events (paged).</p>
        </div>
      </details>

      <p id="admin-users-summary" class="admin-queue-summary" role="status" aria-live="polite">Loading users…</p>

      <div class="admin-users-table-wrap" role="region" aria-label="Registered users table" tabindex="0">
        <table class="admin-users-table">
          <thead>
            <tr>
              <th scope="col">Email</th>
              <th scope="col">Role</th>
              <th scope="col">Verified</th>
              <th scope="col">Joined</th>
              <th scope="col">Workspace access</th>
              <th scope="col">Account</th>
            </tr>
          </thead>
          <tbody id="admin-users-tbody">
            <tr><td colspan="6">Loading…</td></tr>
          </tbody>
        </table>
      </div>

      <div id="admin-users-removed-section" class="admin-users-removed-section" hidden>
        <h3 class="admin-users-removed-heading">Removed accounts</h3>
        <p class="section-subtitle">Backed up and blocked from sign-in. Restore if access should return.</p>
        <div class="admin-users-table-wrap" role="region" aria-label="Removed users table" tabindex="0">
          <table class="admin-users-table">
            <thead>
              <tr>
                <th scope="col">Email</th>
                <th scope="col">Role</th>
                <th scope="col">Removed</th>
                <th scope="col">Reason</th>
                <th scope="col">Account</th>
              </tr>
            </thead>
            <tbody id="admin-users-removed-tbody">
              <tr><td colspan="5">None</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="admin-section admin-section--nested" aria-labelledby="admin-auth-audit-heading">
      <div class="section-header admin-auth-audit-header">
        <div>
          <h3 id="admin-auth-audit-heading">Recent auth events</h3>
          <p id="admin-auth-audit-subtitle" class="section-subtitle">Logins, registrations, password resets, and OAuth.</p>
        </div>
        <div class="admin-auth-audit-pager">
          <button id="admin-auth-audit-prev-btn" type="button" class="btn btn-secondary btn-sm" disabled>Previous</button>
          <button id="admin-auth-audit-next-btn" type="button" class="btn btn-secondary btn-sm" disabled>Next</button>
        </div>
      </div>
      <div class="admin-users-table-wrap admin-auth-audit-scroll" role="region" aria-label="Auth audit log" tabindex="0">
        <table class="admin-users-table admin-auth-audit-table">
          <thead>
            <tr>
              <th scope="col">When</th>
              <th scope="col">Event</th>
              <th scope="col">Email</th>
              <th scope="col">User ID</th>
            </tr>
          </thead>
          <tbody id="admin-auth-audit-tbody">
            <tr><td colspan="4">Loading…</td></tr>
          </tbody>
        </table>
      </div>
    </section>
    </AccountWorkspacePanelBand>
  </div>
</div>
