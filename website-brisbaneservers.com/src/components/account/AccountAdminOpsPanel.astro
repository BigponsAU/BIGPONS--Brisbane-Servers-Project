---
import { accountWorkspace } from '../../data/account-workspace';
import AccountWorkspacePanelBand from './AccountWorkspacePanelBand.astro';
---

<div id="admin-ops-panel" class="portal-panel panel-shell" data-min-role="admin" role="main" aria-label="Admin operations" style="display: none;">
  <div class="admin-content admin-ops-panel-shell">
    <AccountWorkspacePanelBand
      semanticKey="account-admin-ops"
      eyebrow="Platform"
      title={accountWorkspace.adminOpsLabel}
      byline="Today’s AI usage, public search corpus health, and perk redemptions that need a human follow-up."
      titleId="admin-ops-heading"
      variant="primary-light"
    >
      <div slot="actions" class="section-actions admin-panel-quick-links admin-ops-toolbar">
        <button type="button" class="btn btn-secondary btn-sm" onclick="navigateToPanel('admin-billing')">Billing</button>
        <button type="button" class="btn btn-secondary btn-sm" onclick="navigateToPanel('admin-users')">Users</button>
        <button type="button" class="btn btn-secondary btn-sm" onclick="navigateToPanel('library-growth')">Library growth</button>
        <button type="button" id="admin-ops-refresh-all" class="btn btn-secondary btn-sm">Refresh</button>
      </div>

    <section class="admin-section admin-section--in-band" aria-labelledby="admin-ops-heading">

      <details class="panel-guidance-details">
        <summary>What Ops is for</summary>
        <div class="panel-guidance-details__body">
          <p><strong>Usage</strong> — site-wide AI units today (UTC) and how many accounts are near or at cap. Detailed per-user caps live in Billing.</p>
          <p><strong>Search corpus</strong> — identity of the semantic index behind public site search.</p>
          <p><strong>Perk queue</strong> — spotlight / office-hours redemptions waiting for manual fulfilment.</p>
        </div>
      </details>

      <div class="admin-ops-usage-strip" aria-live="polite">
        <div class="admin-ops-usage-strip__main">
          <p id="admin-ops-usage-summary" class="admin-queue-summary">Sign in to load site usage.</p>
          <div id="admin-ops-usage-bar-wrap" class="admin-ops-usage-bar" hidden>
            <div id="admin-ops-usage-bar-fill" class="admin-ops-usage-bar__fill"></div>
          </div>
          <p id="admin-ops-usage-meta" class="form-hint"></p>
        </div>
        <button type="button" id="refresh-admin-ops-usage" class="btn btn-secondary btn-sm">Refresh usage</button>
      </div>

      <div class="admin-ops-workbench">
        <section class="admin-ops-work-block" aria-labelledby="admin-ops-corpus-heading">
          <div class="admin-ops-work-block__header">
            <h3 id="admin-ops-corpus-heading" class="admin-billing-section-title">Search corpus</h3>
            <button type="button" id="refresh-admin-ops-search-corpus" class="btn btn-secondary btn-sm">Refresh</button>
          </div>
          <p class="section-subtitle">Public search uses semantic chunks on the edge worker (<code>GET /api/resources/search</code>).</p>
          <div id="admin-ops-search-corpus" class="admin-ops-search-corpus" aria-live="polite">
            <p class="form-hint">Loading corpus identity…</p>
          </div>
        </section>

        <section class="admin-ops-work-block" aria-labelledby="admin-ops-queue-heading">
          <div class="admin-ops-work-block__header">
            <h3 id="admin-ops-queue-heading" class="admin-billing-section-title">Perk redemption queue</h3>
            <button type="button" id="refresh-admin-ops-token-queue" class="btn btn-secondary btn-sm">Refresh</button>
          </div>
          <p class="section-subtitle">Spotlight and office-hours claims that need a human follow-up before marking done.</p>
          <div id="admin-ops-token-queue" class="admin-ops-token-queue" aria-live="polite"></div>
          <p id="admin-ops-token-queue-status" class="form-hint" role="status"></p>
        </section>
      </div>

      <details class="panel-guidance-details admin-ops-provider-notes">
        <summary>Inference providers (status notes)</summary>
        <div class="panel-guidance-details__body">
          <p id="admin-ops-provider-status" class="section-subtitle">Provider status loads with usage.</p>
          <p>Primary: <strong>NVIDIA NIM</strong> on the edge worker. Fallback: <strong>Cloudflare Workers AI</strong>. If both are unavailable, Generate/Improve use the free template path.</p>
          <p class="form-hint">Secrets and deploy steps live in repo scripts (<code>configure:inference-nvidia</code>, <code>sync:edge-worker-secrets</code>) — not day-to-day Ops work.</p>
        </div>
      </details>
    </section>
    </AccountWorkspacePanelBand>
  </div>
</div>
