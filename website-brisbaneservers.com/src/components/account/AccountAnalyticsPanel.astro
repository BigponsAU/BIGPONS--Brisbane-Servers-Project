---
import AccountWorkspacePanelBand from './AccountWorkspacePanelBand.astro';
---
              <div id="analytics-panel" class="portal-panel panel-shell" data-min-role="editor" role="main" aria-label="Corpus analytics" style="display: none;">
                <div class="admin-content">
            <AccountWorkspacePanelBand
              semanticKey="account-analytics"
              eyebrow="Insights"
              title="Corpus analytics"
              byline="Topic coverage, contribution funnel, and voice quality — measures what the library is missing, not a second Overview."
              titleId="analytics-heading"
              constellationVariant="proof"
            >
              <div slot="actions" class="section-actions admin-panel-quick-links" role="group" aria-label="Related panels">
                <button type="button" id="refresh-analytics" class="btn btn-secondary btn-sm" onclick="loadAnalytics()" aria-label="Refresh analytics">
                  <svg class="btn-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="23 4 23 10 17 10"></polyline>
                    <polyline points="1 20 1 14 7 14"></polyline>
                    <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                  </svg>
                  Refresh
                </button>
                <button type="button" class="btn btn-secondary btn-sm" onclick="navigateToPanel('library-growth')">Library growth</button>
                <button type="button" class="btn btn-secondary btn-sm" onclick="navigateToPanel('voice-map')">Voice map</button>
                <button type="button" class="btn btn-secondary btn-sm" onclick="navigateToPanel('moderation')">Moderation</button>
              </div>

            <section class="admin-section admin-section--in-band" aria-labelledby="analytics-heading">
              <details class="panel-guidance-details">
                <summary>What this panel measures</summary>
                <div class="panel-guidance-details__body">
                  <p><strong>Coverage:</strong> Catalog industry/topic slots vs published guides (gap / sparse / covered).</p>
                  <p><strong>Funnel:</strong> Community contributions accepted, rejected, and still pending.</p>
                  <p><strong>Topic table:</strong> Per-slot publish counts, contribution outcomes, and voice scores.</p>
                  <p><strong>Pipeline suggestions:</strong> Admin-only threshold and starter-block recommendations from the same data.</p>
                </div>
              </details>

              <div id="analytics-content" class="analytics-content" aria-live="polite">
                <p id="analytics-load-status" class="form-hint">Loading corpus analytics…</p>

                <div class="analytics-kpi-grid" id="analytics-kpi-grid" hidden>
                  <div class="analytics-kpi">
                    <span class="analytics-kpi__label">Coverage</span>
                    <span class="analytics-kpi__value" id="analytics-kpi-coverage">—</span>
                    <span class="analytics-kpi__meta" id="analytics-kpi-coverage-meta"></span>
                  </div>
                  <div class="analytics-kpi">
                    <span class="analytics-kpi__label">Gaps</span>
                    <span class="analytics-kpi__value" id="analytics-kpi-gaps">—</span>
                    <span class="analytics-kpi__meta" id="analytics-kpi-gaps-meta"></span>
                  </div>
                  <div class="analytics-kpi">
                    <span class="analytics-kpi__label">Contributions</span>
                    <span class="analytics-kpi__value" id="analytics-kpi-contributions">—</span>
                    <span class="analytics-kpi__meta" id="analytics-kpi-contributions-meta"></span>
                  </div>
                  <div class="analytics-kpi">
                    <span class="analytics-kpi__label">Acceptance</span>
                    <span class="analytics-kpi__value" id="analytics-kpi-acceptance">—</span>
                    <span class="analytics-kpi__meta" id="analytics-kpi-acceptance-meta"></span>
                  </div>
                  <div class="analytics-kpi">
                    <span class="analytics-kpi__label">Published guides</span>
                    <span class="analytics-kpi__value" id="analytics-kpi-published">—</span>
                    <span class="analytics-kpi__meta" id="analytics-kpi-published-meta"></span>
                  </div>
                  <div class="analytics-kpi">
                    <span class="analytics-kpi__label">Avg voice</span>
                    <span class="analytics-kpi__value" id="analytics-kpi-voice">—</span>
                    <span class="analytics-kpi__meta" id="analytics-kpi-voice-meta"></span>
                  </div>
                </div>

                <div class="analytics-section" id="analytics-gaps-section" hidden>
                  <h3 class="workspace-section-title">Priority gaps</h3>
                  <p class="section-subtitle">Topics with no or thin published coverage, or with pending contributions waiting on moderation.</p>
                  <div id="analytics-gaps-list" class="analytics-gaps-list"></div>
                </div>

                <div class="analytics-section" id="analytics-topics-section" hidden>
                  <div class="analytics-section__header">
                    <div>
                      <h3 class="workspace-section-title">Topic coverage</h3>
                      <p class="section-subtitle">Full catalog matrix — sort by status, pending queue, or industry.</p>
                    </div>
                    <label class="analytics-filter">
                      <span class="sr-only">Filter topics</span>
                      <select id="analytics-topic-filter" class="form-select" aria-label="Filter topics">
                        <option value="all">All topics</option>
                        <option value="gap">Gaps only</option>
                        <option value="sparse">Sparse only</option>
                        <option value="covered">Covered only</option>
                        <option value="pending">Has pending</option>
                      </select>
                    </label>
                  </div>
                  <div class="analytics-table-wrap">
                    <table class="analytics-table" id="analytics-topics-table">
                      <thead>
                        <tr>
                          <th scope="col">Industry</th>
                          <th scope="col">Topic</th>
                          <th scope="col">Status</th>
                          <th scope="col">Published</th>
                          <th scope="col">Drafts</th>
                          <th scope="col">Pending</th>
                          <th scope="col">Accepted</th>
                          <th scope="col">Rejected</th>
                          <th scope="col">Voice</th>
                        </tr>
                      </thead>
                      <tbody id="analytics-topics-body"></tbody>
                    </table>
                  </div>
                </div>

                <div id="analytics-suggestions-section" class="analytics-section analytics-suggestions-section" data-min-role="admin" hidden>
                  <h3 class="workspace-section-title">Pipeline config &amp; suggestions</h3>
                  <p class="section-subtitle">Data-driven suggestions to tune auto-approval and quality. Apply changes below to update the pipeline.</p>
                  <div id="analytics-config-display" class="analytics-config-display"></div>
                  <div id="analytics-suggestions-list" class="analytics-suggestions-list"></div>
                </div>

                <div id="analytics-index-section" class="analytics-section" data-min-role="admin" hidden>
                  <h3 class="workspace-section-title">Semantic index health</h3>
                  <p class="section-subtitle">How much of the published corpus is searchable via embeddings.</p>
                  <div id="analytics-index-body" class="analytics-index-body"></div>
                </div>
              </div>
            </section>
            </AccountWorkspacePanelBand>
                </div>
              </div>
