---
import AccountWorkspacePanelBand from './AccountWorkspacePanelBand.astro';
---
              <div id="analytics-panel" class="portal-panel panel-shell" data-min-role="editor" role="main" aria-label="Analytics" style="display: none;">
                <div class="admin-content">
            <AccountWorkspacePanelBand
              semanticKey="account-analytics"
              eyebrow="Insights"
              title="Corpus analytics"
              byline="Corpus performance, voice alignment, and pipeline suggestions — separate from day-to-day create tools."
              titleId="analytics-heading"
              constellationVariant="proof"
            >
              <button slot="actions" id="refresh-analytics" class="btn btn-secondary btn-sm section-actions" onclick="loadAnalytics()" aria-label="Refresh analytics">
                <svg class="btn-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="23 4 23 10 17 10"></polyline>
                  <polyline points="1 20 1 14 7 14"></polyline>
                  <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                </svg>
                Refresh
              </button>

            <section class="admin-section admin-section--in-band" aria-labelledby="analytics-heading">
              <details class="panel-guidance-details">
                <summary>Understanding your metrics</summary>
                <div class="panel-guidance-details__body">
                  <p><strong>Your resources:</strong> Content you created or copied from starter blocks (improve updates in place — it does not duplicate).</p>
                  <p><strong>Published / drafts:</strong> Live vs in-progress items among your resources.</p>
                  <p><strong>Avg voice score:</strong> Alignment with your active voice profile (0–100%).</p>
                </div>
              </details>
              
              <div id="analytics-content" class="analytics-content">
                <div class="dashboard-stats-grid stats-grid">
                  <div class="stat-card" title="Resources you created or copied from starter blocks">
                    <div class="stat-icon" aria-hidden="true">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                      </svg>
                    </div>
                    <div class="stat-content">
                      <h3>Your Resources</h3>
                      <p class="stat-value" id="stat-total-resources">-</p>
                      <p class="stat-description">Your content items</p>
                    </div>
                  </div>
                  <div class="stat-card" title="Published resources available to users">
                    <div class="stat-icon" aria-hidden="true">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                    </div>
                    <div class="stat-content">
                      <h3>Published</h3>
                      <p class="stat-value" id="stat-published">-</p>
                      <p class="stat-description">Live content</p>
                    </div>
                  </div>
                  <div class="stat-card" title="Resources in development">
                    <div class="stat-icon" aria-hidden="true">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                      </svg>
                    </div>
                    <div class="stat-content">
                      <h3>Drafts</h3>
                      <p class="stat-value" id="stat-drafts">-</p>
                      <p class="stat-description">In progress</p>
                    </div>
                  </div>
                  <div class="stat-card" title="Average voice alignment score">
                    <div class="stat-icon" aria-hidden="true">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <circle cx="12" cy="12" r="3"></circle>
                      </svg>
                    </div>
                    <div class="stat-content">
                      <h3>Avg Voice Score</h3>
                      <p class="stat-value" id="stat-avg-score">-</p>
                      <p class="stat-description">Quality metric</p>
                    </div>
                  </div>
                </div>
                <div class="dashboard-quick-actions quick-links">
                  <h3 class="workspace-section-title">Quick Actions</h3>
                  <div class="quick-actions-grid quick-links-grid">
                    <a href="/resources" class="quick-action-card quick-link-card" target="_blank" rel="noopener noreferrer">
                      <svg class="quick-action-icon quick-link-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="2" y1="12" x2="22" y2="12"></line>
                        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                      </svg>
                      <span class="quick-action-label quick-link-text">View Public Resources</span>
                    </a>
                    <button type="button" class="quick-action-card quick-link-card" onclick="exportResources()">
                      <svg class="quick-action-icon quick-link-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                      </svg>
                      <span class="quick-action-label quick-link-text">Export Resources</span>
                    </button>
                    <button type="button" class="quick-action-card quick-link-card" onclick="bulkImproveResources()">
                      <svg class="quick-action-icon quick-link-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                        <path d="M2 17l10 5 10-5"></path>
                        <path d="M2 12l10 5 10-5"></path>
                      </svg>
                      <span class="quick-action-label quick-link-text">Bulk Improve Resources</span>
                    </button>
                  </div>
                </div>
                <div id="analytics-suggestions-section" class="analytics-suggestions-section">
                  <h3 class="workspace-section-title">Pipeline config &amp; suggestions</h3>
                  <p class="section-subtitle">Data-driven suggestions to tune auto-approval and quality. Apply changes below to update the pipeline.</p>
                  <div id="analytics-config-display" class="analytics-config-display"></div>
                  <div id="analytics-suggestions-list" class="analytics-suggestions-list"></div>
                </div>
                <div id="analytics-admin-meta" class="analytics-admin-meta" data-min-role="admin">
                  <h3 class="workspace-section-title">Admin: Users &amp; vectors</h3>
                  <p class="section-subtitle">Platform-wide user count and semantic index size (admin only).</p>
                  <div id="analytics-users-vectors" class="analytics-users-vectors"></div>
                </div>
              </div>
            </section>
            </AccountWorkspacePanelBand>
                </div>
              </div>
