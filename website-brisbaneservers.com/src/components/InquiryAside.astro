---
import { Image } from 'astro:assets';
import { valueProposition } from '../data/value-proposition';
import bigponsBanner from '../bigpons-banner.png';

const panel = valueProposition.home.inquiryPanel;
---

<aside class="home-inquiry-aside" aria-label={panel.eyebrow}>
  <figure class="home-inquiry-aside__brand">
    <Image
      src={bigponsBanner}
      alt="BIGPONS — Brisbane Servers. Access to truth in technology. Local data pipeline solutions and Brisbane's sovereign edge infrastructure."
      widths={[360, 480, 640]}
      sizes="(max-width: 900px) 100vw, 28rem"
      class="home-inquiry-aside__brand-img"
      loading="lazy"
      decoding="async"
    />
  </figure>
  <div>
    <p class="home-inquiry-aside__eyebrow">{panel.eyebrow}</p>
    <p class="home-inquiry-aside__lead">{panel.lead}</p>
    <ul class="home-inquiry-aside__list">
      {panel.points.map((point) => (
        <li>{point}</li>
      ))}
    </ul>
  </div>
  <dl class="home-inquiry-aside__contact" aria-label={panel.contactEyebrow}>
    <div>
      <dt>Phone</dt>
      <dd>
        <a href={`tel:${panel.phone.replace(/\s+/g, '')}`}>{panel.phone}</a>
        <span class="home-inquiry-aside__note">{panel.phoneNote}</span>
      </dd>
    </div>
    <div>
      <dt>Email</dt>
      <dd>
        <a href={`mailto:${panel.email}`}>{panel.email}</a>
        <span class="home-inquiry-aside__note">{panel.emailNote}</span>
      </dd>
    </div>
    <div>
      <dt>Location</dt>
      <dd>
        {panel.location}
        <span class="home-inquiry-aside__note">{panel.locationNote}</span>
      </dd>
    </div>
  </dl>
</aside>
