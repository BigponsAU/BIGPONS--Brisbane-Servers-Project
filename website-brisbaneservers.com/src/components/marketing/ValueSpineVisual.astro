---
/**
 * Abstract value-flow spine — fills visual space without duplicating adjacent card copy.
 * Uses the site engagement model (context → evidence → scope → delivery).
 */
import { valueProposition } from '../../data/value-proposition';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const { valuePath } = valueProposition.home;
const uid = `vspine-${Math.random().toString(36).slice(2, 9)}`;

const nodeY = [58, 128, 198, 268];
---

<figure
  class:list={['value-spine-visual', className]}
  aria-label={`${valuePath.eyebrow}: ${valuePath.steps.map((s) => s.title).join(', ')}`}
>
  <p class="value-spine-visual__eyebrow">{valuePath.eyebrow}</p>
  <svg
    class="value-spine-visual__svg"
    viewBox="0 0 260 300"
    role="img"
    aria-hidden="true"
    focusable="false"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <linearGradient id={`${uid}-rail`} x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#0A74DA" stop-opacity="0.5" />
        <stop offset="50%" stop-color="#5B6FD6" stop-opacity="0.6" />
        <stop offset="100%" stop-color="#0A74DA" stop-opacity="0.45" />
      </linearGradient>
      <radialGradient id={`${uid}-glow`} cx="30%" cy="45%" r="65%">
        <stop offset="0%" stop-color="#0A74DA" stop-opacity="0.1" />
        <stop offset="100%" stop-color="#0A74DA" stop-opacity="0" />
      </radialGradient>
    </defs>
    <rect width="260" height="300" fill={`url(#${uid}-glow)`} rx="10" />
    <line x1="56" y1="58" x2="56" y2="268" stroke={`url(#${uid}-rail)`} stroke-width="2.5" stroke-linecap="round" />
    {
      valuePath.steps.map((step, i) => (
        <g>
          <circle cx="56" cy={nodeY[i]} r="20" fill="#fff" stroke="#0A74DA" stroke-width="1.35" />
          <text
            x="56"
            y={nodeY[i] + 1}
            text-anchor="middle"
            dominant-baseline="middle"
            font-size="10"
            font-weight="700"
            fill="#0A74DA"
          >
            {String(i + 1).padStart(2, '0')}
          </text>
          <text x="88" y={nodeY[i] + 1} dominant-baseline="middle" font-size="13" font-weight="600" fill="#1A1A1A">
            {step.title}
          </text>
          {i < valuePath.steps.length - 1 && (
            <line
              x1="56"
              y1={nodeY[i] + 22}
              x2="56"
              y2={nodeY[i + 1] - 22}
              stroke="#0A74DA"
              stroke-width="1"
              stroke-opacity="0.22"
              stroke-dasharray="3 5"
            />
          )}
        </g>
      ))
    }
    <path
      d="M 56 268 L 88 286 L 210 286"
      stroke={`url(#${uid}-rail)`}
      stroke-width="1.5"
      fill="none"
      stroke-linecap="round"
      opacity="0.55"
    />
    <circle cx="210" cy="286" r="3.5" fill="#5B6FD6" />
  </svg>
  <p class="value-spine-visual__outcome">{valuePath.outcome}</p>
</figure>
