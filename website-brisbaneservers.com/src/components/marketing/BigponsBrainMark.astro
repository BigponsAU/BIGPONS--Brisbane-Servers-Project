---
/** BIGPONS brain + speech-tail mark — matches site logo neural network silhouette. */
interface Props {
  class?: string;
  gradientId?: string;
}

const { class: className = '', gradientId = `bigpons-brain-${Math.random().toString(36).slice(2, 11)}` } =
  Astro.props;

type Node = { cx: number; cy: number; r: number };
type Edge = [number, number];

/** Node layout: twin hemispheres, central bridge, speech tail lower-right. */
const nodes: Node[] = [
  { cx: 50, cy: 13, r: 3.4 },
  { cx: 34, cy: 21, r: 2.9 },
  { cx: 66, cy: 21, r: 2.9 },
  { cx: 26, cy: 33, r: 2.5 },
  { cx: 40, cy: 30, r: 2.7 },
  { cx: 50, cy: 27, r: 3.1 },
  { cx: 60, cy: 30, r: 2.7 },
  { cx: 74, cy: 33, r: 2.5 },
  { cx: 30, cy: 44, r: 2.4 },
  { cx: 44, cy: 41, r: 2.6 },
  { cx: 56, cy: 41, r: 2.6 },
  { cx: 70, cy: 44, r: 2.4 },
  { cx: 38, cy: 54, r: 2.3 },
  { cx: 50, cy: 51, r: 2.8 },
  { cx: 62, cy: 54, r: 2.3 },
  { cx: 46, cy: 63, r: 2.2 },
  { cx: 58, cy: 63, r: 2.2 },
  { cx: 68, cy: 70, r: 2.1 },
  { cx: 80, cy: 82, r: 2.4 },
];

const edges: Edge[] = [
  [0, 1],
  [0, 2],
  [1, 3],
  [1, 4],
  [2, 5],
  [2, 7],
  [0, 5],
  [4, 5],
  [5, 6],
  [3, 8],
  [4, 9],
  [5, 10],
  [6, 11],
  [7, 11],
  [8, 9],
  [9, 10],
  [10, 11],
  [9, 12],
  [10, 13],
  [11, 14],
  [12, 13],
  [13, 14],
  [13, 15],
  [14, 16],
  [14, 17],
  [16, 17],
  [17, 18],
];
---

<svg
  class:list={['bigpons-brain-mark', className]}
  viewBox="0 0 100 92"
  role="img"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={gradientId} x1="18%" y1="8%" x2="88%" y2="92%">
      <stop offset="0%" stop-color="#2eb0f0" />
      <stop offset="48%" stop-color="#0A74DA" />
      <stop offset="100%" stop-color="#7c3aed" />
    </linearGradient>
  </defs>
  {
    edges.map(([a, b]) => (
      <line
        x1={nodes[a].cx}
        y1={nodes[a].cy}
        x2={nodes[b].cx}
        y2={nodes[b].cy}
        stroke={`url(#${gradientId})`}
        stroke-width="1.35"
        stroke-linecap="round"
        opacity="0.82"
      />
    ))
  }
  {
    nodes.map((node) => (
      <circle cx={node.cx} cy={node.cy} r={node.r} fill={`url(#${gradientId})`} />
    ))
  }
  <path
    d="M 62 66 L 74 78 L 66 74 Z"
    fill={`url(#${gradientId})`}
    opacity="0.92"
  />
</svg>
