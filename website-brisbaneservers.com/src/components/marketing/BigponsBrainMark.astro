---
/** Brain mark — top crop of favicon.png (wordmark below is clipped). */
import favicon from '../../favicon.png';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<img
  src={favicon.src}
  alt=""
  width={favicon.width}
  height={favicon.height}
  class:list={['bigpons-brain-mark', className]}
  loading="eager"
  decoding="async"
/>
