---
/** Brain icon from the canonical BIGPONS favicon asset (top crop — no wordmark). */
import { Image } from 'astro:assets';
import favicon from '../../favicon.png';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<span class:list={['bigpons-brain-mark', className]} aria-hidden="true">
  <Image
    src={favicon}
    alt=""
    widths={[96, 128, 160, 192]}
    class="bigpons-brain-mark__img"
    loading="eager"
    decoding="async"
  />
</span>
